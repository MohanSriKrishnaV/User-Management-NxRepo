    "@angular/compiler-cli": "^20.3.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "23.1.2",
    "@nx/eslint": "23.1.2",
    "@nx/eslint-plugin": "23.1.2",
    "@nx/jest": "23.1.2",
    "@nx/js": "23.1.2",
    "@nx/workspace": "23.1.2",
    "@schematics/angular": "^20.3.35",
    "@swc/helpers": "~0.5.18",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^29.5.12",
    "@types/node": "18.16.9",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^20.3.0",
    "concurrently": "^10.0.5",
