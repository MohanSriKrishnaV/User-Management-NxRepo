{
  "name": "user-management",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "watch": "nx build --watch --configuration development",
    "start": "nx serve user-management",
    "api": "json-server --watch db/db.json --port 3000",
    "start:all": "concurrently \"npm run api\" \"npm run start\"",
    "build": "nx build user-management",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "graph": "nx graph"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
